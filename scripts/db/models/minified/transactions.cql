CREATE TABLE IF NOT EXISTS transactions (
  chunk int,
  block_number bigint,
  transaction_index int,
  hash text,
  block_timestamp_s bigint,
  block_timestamp_ms bigint,
  method_id text,
  input text,
  from_address text,
  to_address text,
  value bigint,
  gas_limit bigint,
  gas_price bigint,
  gas_used bigint,
  max_priority_fee_per_gas bigint,
  max_fee_per_gas bigint,
  cumulative_gas_used bigint,
  effective_gas_price bigint,
  contract_address text,
  status tinyint,
  type tinyint,
  PRIMARY KEY ((chunk), block_number, transaction_index)
) WITH CLUSTERING ORDER BY (block_number ASC, transaction_index ASC);